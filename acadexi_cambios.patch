+def _acomodar(ventana):
+
+    y= ventana.height() - MARGEN
+    for aviso in _avisos_por_ventana.get(ventana, []):
+        aviso.adjustSize()
+        y-= aviso.height()
+        aviso.move(max(ventana.width() - aviso.width() - MARGEN, 0), max(y, 0))
+        aviso.raise_()
+        y-= SEPARACION
